rules_version = '2';

// Client rules for the Vral Altos *platform* database (deployed from
// apps/console). Agents, the Mac worker, the cloud runner and Autobench use
// IAM and are not subject to these rules. Clients get:
// - the operator only (the verified Google account below), nobody else;
// - read access to the Console's data and the status the system reports;
// - write access only to start threads and queue operator messages; to
//   rename, pin, archive and file threads (project, purpose) and keep the
//   chat projects; to cancel a queued message or ask a
//   running one to stop; to queue Factory requests and decide approvals.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'siddharth.chitikela@gmail.com';
    }

    function isShortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // A conversation's project: a chat project's name, or null (General).
    function isProject(v) {
      return v == null || isShortString(v, 80);
    }

    // Conversations: created by the Console, maintained by the workers
    // (cost, name: `ChatNamer`). The operator may file them: project,
    // purpose, topic (`title`); `projectSet` / `titleSet` keep the namer off.
    match /threads/{threadId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['agent', 'title', 'createdAt', 'updatedAt', 'closed', 'project', 'projectSet'])
        && request.resource.data.agent.matches('^[a-z0-9][a-z0-9_-]{0,40}$')
        && isShortString(request.resource.data.title, 200)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.closed == false
        && isProject(request.resource.data.get('project', null))
        && request.resource.data.get('projectSet', false) is bool;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'titleSet', 'pinned', 'archived', 'project', 'projectSet', 'purpose', 'model', 'effort'])
        && isShortString(request.resource.data.title, 200)
        && request.resource.data.get('pinned', false) is bool
        && request.resource.data.get('archived', false) is bool
        && request.resource.data.get('titleSet', false) is bool
        && request.resource.data.get('projectSet', false) is bool
        && isProject(request.resource.data.get('project', null))
        && request.resource.data.get('purpose', 'other')
             in ['build', 'fix', 'research', 'plan', 'advice', 'ops', 'admin', 'other']
        && request.resource.data.get('model', 'claude-opus-5-5')
             in ['claude-opus-5-5', 'claude-sonnet-5-5', 'claude-haiku-5-5', 'claude-fable-5-2']
        && request.resource.data.get('effort', 'medium') in ['low', 'medium', 'high', 'xhigh', 'max'];
      allow delete: if false;
    }

    // The projects conversations are filed under; the operator keeps the
    // list, the namer reads it.
    match /chat_projects/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isShortString(request.resource.data.name, 80)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && isShortString(request.resource.data.name, 80);
      allow delete: if isOwner();
    }

    // The mailbox: the Console only queues operator messages; replies and
    // status changes come from the workers.
    match /messages/{messageId} {
      allow read: if isOwner();
      // Attachments (files in the attachments bucket, storage.rules) and
      // @mentions: at most 10 each; with files the text may be empty.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['threadId', 'role', 'kind', 'text', 'status', 'createdAt', 'attachments', 'mentions'])
        && request.resource.data.role == 'operator'
        && request.resource.data.status == 'queued'
        && request.resource.data.kind in ['turn', 'close']
        && (!('attachments' in request.resource.data) || (request.resource.data.attachments is list
          && request.resource.data.attachments.size() > 0 && request.resource.data.attachments.size() <= 10))
        && (!('mentions' in request.resource.data) || (request.resource.data.mentions is list
          && request.resource.data.mentions.size() > 0 && request.resource.data.mentions.size() <= 10))
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000
        && (request.resource.data.text.size() > 0 || 'attachments' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.threadId is string
        && existsAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId))
        && getAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.closed == false;
      // Stop: a queued message is cancelled; a running one is asked to stop
      // (its worker ends the turn).
      allow update: if isOwner() && resource.data.role == 'operator' && (
        (resource.data.status == 'queued'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
        || (resource.data.status == 'running'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelRequested'])
          && request.resource.data.cancelRequested == true));
      allow delete: if false;
    }

    // Reported by the system; read-only for the Console.
    match /status/{doc} {
      allow read: if isOwner();
    }
    match /agent_mesh/{doc} {
      allow read: if isOwner();
    }
    match /autobench/latest {
      allow read: if isOwner();
    }
    match /devstations/{id} {
      allow read: if isOwner();
    }
    match /stats/{doc} {
      allow read: if isOwner();
    }
    match /usage_days/{day} {
      allow read: if isOwner();
    }
    // The estate's inventory: written by the Mac worker (admin), read by
    // the Console.
    match /topology/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /billing/{doc} {
      allow read: if isOwner();
    }

    // Telemetry: services write with IAM; the Console reads everything and
    // adds only its own entries (its audit trail and client errors).
    match /metrics/{id} {
      allow read: if isOwner();
    }
    match /logs/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['at', 'source', 'component', 'severity', 'message', 'fields', 'expireAt'])
        && request.resource.data.source == 'console'
        && request.resource.data.component in ['audit', 'client']
        && request.resource.data.severity in ['info', 'warning', 'error']
        && isShortString(request.resource.data.message, 2000)
        && request.resource.data.at == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt < request.time + duration.value(31, 'd')
        && (!('fields' in request.resource.data) || (request.resource.data.fields is map && request.resource.data.fields.size() <= 20));
      allow update, delete: if false;
    }

    // The Factory: the Console queues requests; the cloud runner applies them.
    match /factory_requests/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['action', 'devstationId', 'project', 'machineType', 'diskGb', 'repoUrl', 'status', 'createdAt'])
        && request.resource.data.action in ['create', 'start', 'stop', 'destroy']
        && request.resource.data.devstationId.matches('^[a-z][a-z0-9-]{1,19}$')
        && request.resource.data.status == 'queued'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.action != 'create' || (
             request.resource.data.project.matches('^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$')
             && request.resource.data.machineType in ['e2-medium', 'e2-standard-2', 'e2-standard-4', 'e2-standard-8']
             && request.resource.data.repoUrl is string
             && request.resource.data.repoUrl.size() <= 300
             && (!('diskGb' in request.resource.data)
                 || (request.resource.data.diskGb is int
                     && request.resource.data.diskGb >= 30 && request.resource.data.diskGb <= 200))));
      allow update, delete: if false;
    }

    // Agents' approval requests: the operator only approves or rejects.
    match /approvals/{id} {
      allow read: if isOwner();
      allow update: if isOwner()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedAt == request.time;
      allow create, delete: if false;
    }
  }
}
