rules_version = '2';

// Client rules for the Vral Altos *platform* database (deployed from
// apps/console). Agents, the Mac worker, the cloud runner and Autobench use
// IAM and are not subject to these rules. Clients get:
// - the operator only (the verified Google account below), nobody else;
// - read access to the Console's data and the status the system reports;
// - write access only to start threads and queue operator messages.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'siddharth.chitikela@gmail.com';
    }

    function isShortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Conversations: created by the Console, maintained by the workers.
    match /threads/{threadId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['agent', 'title', 'createdAt', 'updatedAt', 'closed'])
        && request.resource.data.agent.matches('^[a-z0-9][a-z0-9_-]{0,40}$')
        && isShortString(request.resource.data.title, 200)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.closed == false;
      allow update, delete: if false;
    }

    // The mailbox: the Console only queues operator messages; replies and
    // status changes come from the workers.
    match /messages/{messageId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['threadId', 'role', 'kind', 'text', 'status', 'createdAt'])
        && request.resource.data.role == 'operator'
        && request.resource.data.status == 'queued'
        && request.resource.data.kind in ['turn', 'close']
        && isShortString(request.resource.data.text, 20000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.threadId is string
        && existsAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId))
        && getAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.closed == false;
      allow update, delete: if false;
    }

    // Reported by the system; read-only for the Console.
    match /status/{doc} {
      allow read: if isOwner();
    }
    match /agent_mesh/{doc} {
      allow read: if isOwner();
    }
    match /autobench/latest {
      allow read: if isOwner();
    }
    match /devstations/{id} {
      allow read: if isOwner();
    }

    // The Factory: the Console queues requests; the cloud runner applies them.
    match /factory_requests/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['action', 'devstationId', 'project', 'machineType', 'repoUrl', 'status', 'createdAt'])
        && request.resource.data.action in ['create', 'start', 'stop', 'destroy']
        && request.resource.data.devstationId.matches('^[a-z][a-z0-9-]{1,19}$')
        && request.resource.data.status == 'queued'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.action != 'create' || (
             request.resource.data.project.matches('^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$')
             && request.resource.data.machineType in ['e2-medium', 'e2-standard-2', 'e2-standard-4', 'e2-standard-8']
             && request.resource.data.repoUrl is string
             && request.resource.data.repoUrl.size() <= 300));
      allow update, delete: if false;
    }

    // Agents' approval requests: the operator only approves or rejects.
    match /approvals/{id} {
      allow read: if isOwner();
      allow update: if isOwner()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedAt == request.time;
      allow create, delete: if false;
    }
  }
}
