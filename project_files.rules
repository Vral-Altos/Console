rules_version = '2';

// Project context files: `projects/<project id>/…` in the agent-state bucket
// (vral-altos-agent-state, linked to Firebase Storage in infra/storage.tf).
// Only the operator's verified Google account may read, list, write or
// delete them (Genie's file tree); 5 MB a file, no hidden segments. The
// rest of the bucket (agents' private state/) is not reachable through
// Firebase at all. Workers use their IAM identities, outside these rules
// (meshes/agent_mesh ProjectContext).
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'siddharth.chitikela@gmail.com';
    }

    match /projects/{projectId}/{path=**} {
      allow read: if isOwner() && projectId.matches('^[a-z0-9][a-z0-9-]{0,79}$');
      allow create, update: if isOwner()
        && projectId.matches('^[a-z0-9][a-z0-9-]{0,79}$')
        && !request.resource.name.matches('.*/[.][^/]*')
        && request.resource.name.size() <= 400
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isOwner();
    }

    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
