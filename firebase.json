{
  "firestore": [
    {
      "database": "platform",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "va-console",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "//": "Flutter's file names are not versioned (main.dart.js, the trimmed icon font), so every file revalidates (cheap: ETags). Otherwise a deploy shows stale code or missing icons for up to an hour.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "storage": {
      "port": 9199
    }
  },
  "storage": [
    {
      "target": "attachments",
      "rules": "storage.rules"
    }
  ]
}
